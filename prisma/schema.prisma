generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  username  String  @unique
  name      String?
  password  String
  contactNo String?

  roles      String  @default("GUEST")
  department String?

  active    Boolean @default(true)
  isDeleted Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  activityLogs    ActivityLog[]
  createdMembers  Member[]
  clusterManagers ClusterManager[]
  branchManagers  BranchManager[]
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  label       String
  permissions Permission[]
}

model Permission {
  id       Int    @id @default(autoincrement())
  name     String @unique
  label    String
  category String
  roles    Role[]
}

model Member {
  id              Int           @id @default(autoincrement())

  firstName       String
  middleName      String?
  lastName        String

  membership      String
  age             Int
  address         String
  status          String
  civilStatus     String?
  clientId        Int?
  transactionDate DateTime?
  dateOfBirth     DateTime?
  loanCycle       Int?
  statusChangedAt DateTime?

  createdById     Int?
  createdBy       User?         @relation(fields: [createdById], references: [id])

  branch          String?
  isDeleted       Boolean       @default(false)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime?     @updatedAt

  activityLogs    ActivityLog[]
  beneficiaries   Beneficiary[]
  dependents      Dependent[]
}

model Beneficiary {
  id       Int    @id @default(autoincrement())
  memberId Int
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  role         String
  name         String
  address      String
  birthday     String
  gender       String
  relationship String
}

model Dependent {
  id       Int    @id @default(autoincrement())
  memberId Int
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  name     String
  address  String
  birthday String
  gender   String
}

model Report {
  id              Int       @id @default(autoincrement())
  type            String
  total           Int       @default(0)
  dateRangeStart  String
  dateRangeEnd    String
  generatedDate   String

  createdAt       DateTime  @default(now())
  updatedAt       DateTime? @updatedAt
}

model ActivityLog {
  id          Int    @id @default(autoincrement())
  type        String
  title       String
  description String
  subjectName String
  actorName   String
  actionLabel String
  date        String

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  memberId Int?
  member   Member? @relation(fields: [memberId], references: [id])

  userId Int?
  user   User? @relation(fields: [userId], references: [id])
}

model Cluster {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  branches        Branch[]
  clusterManagers ClusterManager[]
}

model Branch {
  id        Int       @id @default(autoincrement())
  clusterId Int
  cluster   Cluster   @relation(fields: [clusterId], references: [id])
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  branchManagers BranchManager[]
}

model ClusterManager {
  id        Int     @id @default(autoincrement())
  userId    Int
  user      User    @relation(fields: [userId], references: [id])
  clusterId Int
  cluster   Cluster @relation(fields: [clusterId], references: [id])

  @@unique([userId, clusterId])
}

model BranchManager {
  id       Int    @id @default(autoincrement())
  userId   Int
  user     User   @relation(fields: [userId], references: [id])
  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  @@unique([userId, branchId])
}
