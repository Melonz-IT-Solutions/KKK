generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  username     String       @unique
  name         String?
  password     String
  contactNo    String?
  roles        String       @default("STAFF")
  active       Boolean      @default(true)
  isDeleted    Boolean      @default(false)
  departments  String[]     @default([])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime?    @updatedAt
  staff        Staff?
  activityLogs ActivityLog[]
}

model Member {
  id              Int           @id @default(autoincrement())
  fullName        String
  firstName       String?
  middleName      String?
  lastName        String?
  membership      String
  age             Int
  branch          String
  address         String?
  status          String
  civilStatus     String?
  clientId        Int?
  transactionDate DateTime?
  dateOfBirth     DateTime?
  loanCycle       Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime?     @updatedAt
  activityLogs    ActivityLog[]
  beneficiaries   Beneficiary[]
  dependents      Dependent[]
}

model Beneficiary {
  id           Int      @id @default(autoincrement())
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId     Int
  role         String   // 'primary' | 'secondary'
  name         String
  address      String
  birthday     String
  gender       String
  relationship String
}

model Dependent {
  id       Int    @id @default(autoincrement())
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId Int
  name     String
  address  String
  birthday String
  gender   String
}
// Add to schema.prisma

enum StaffRole {
  SUPER_ADMIN
  FINANCE
  STAFF
  BRANCH_MANAGER
}

model Staff {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  department   String
  branch       String?      // organization level: which branch this staff belongs to
  role         StaffRole    @default(STAFF)
  password     String
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime?    @updatedAt
  userId       Int?         @unique
  user         User?        @relation(fields: [userId], references: [id])
  activityLogs ActivityLog[]

  // Hierarchy: who this staff member reports to, and who reports to them.
  managerId    Int?
  manager      Staff?       @relation("StaffReportsTo", fields: [managerId], references: [id])
  directReports Staff[]     @relation("StaffReportsTo")
}


model Report {
  id            Int      @id @default(autoincrement())
  type          String
  dateRangeStart String
  dateRangeEnd  String
  generatedDate String
  createdAt     DateTime @default(now())
  updatedAt     DateTime? @updatedAt
}

model ActivityLog {
  id           Int      @id @default(autoincrement())
  type         String
  title        String
  description  String
  subjectName  String
  actorName    String
  actionLabel  String

  // Display date, example: August 10, 2026
  date         String

  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  memberId     Int?
  member       Member?  @relation(fields: [memberId], references: [id])

  staffId      Int?
  staff        Staff?   @relation(fields: [staffId], references: [id])

  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
}